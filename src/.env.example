# PortPulse Environment Configuration Example
# Copy this file to .env before starting the backend or frontend

# Backend Server Configuration
PORTPULSE_ENV=development                       # Environment mode: development / staging / production
PORTPULSE_HOST=127.0.0.1                         # Bind host for FastAPI
PORTPULSE_PORT=8000                              # Bind port for FastAPI
PORTPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # Allowed CORS origins

# Database Configuration (SQLite for local dev on i3/8GB)
PORTPULSE_DB_URL=sqlite:///./portpulse.db       # Database connection URL (SQLite dev / PostgreSQL prod)

# Security & RBAC
PORTPULSE_SECRET_KEY=demo-secret-key-replace-in-production-min32bytes  # Secret key for signing JWTs
PORTPULSE_ACCESS_TOKEN_EXPIRE_MINUTES=15        # Access token expiration time in minutes

# Ingestion / Synthetic Data Defaults
PORTPULSE_SYNTHETIC_VESSELS=50                  # Default vessel count for local dev (50-150)
PORTPULSE_SYNTHETIC_BERTHS=10                   # Default berth count for local dev (10-20)
PORTPULSE_SYNTHETIC_SEED=42                     # Random seed for reproducible generation

# watsonx.ai / LLM Settings (for Increment 4)
WATSONX_APIKEY=dummy-watsonx-api-key            # IBM watsonx.ai API Key
WATSONX_PROJECT_ID=dummy-project-id             # IBM watsonx.ai Project ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com   # IBM watsonx.ai endpoint URL
